<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>我的第一个 HTML 程序</title>
  <style>
    body {
      font-family: system-ui, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
      background: #f5f7fa;
    }

    .card {
      background: white;
      padding: 32px 40px;
      border-radius: 16px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
      text-align: center;
    }

    h1 {
      margin-top: 0;
      font-size: 24px;
    }

    #count {
      font-size: 48px;
      font-weight: bold;
      color: #2563eb;
      margin: 16px 0;
    }

    button {
      padding: 10px 18px;
      border: none;
      border-radius: 8px;
      background: #2563eb;
      color: white;
      font-size: 16px;
      cursor: pointer;
      margin: 4px;
    }

    button:hover {
      background: #1d4ed8;
    }
  </style>
</head>
<body>
  <div class="card">
    <h1>点击计数器</h1>
    <div id="count">0</div>
    <button id="addBtn">+1</button>
    <button id="resetBtn">重置</button>
  </div>

  <script>
    let count = 0;

    const countEl = document.getElementById('count');
    const addBtn = document.getElementById('addBtn');
    const resetBtn = document.getElementById('resetBtn');

    addBtn.addEventListener('click', () => {
      count++;
      countEl.textContent = count;
    });

    resetBtn.addEventListener('click', () => {
      count = 0;
      countEl.textContent = count;
    });
  </script>
</body>
</html>
